<?xml version="1.0" encoding="utf-8"?>
<model version="NetLogo 7.0.0" snapToGrid="false">
  <code><![CDATA[;; ============================================================================
;; TOWER DEFENSE - Complex Adaptive System Model
;; ============================================================================
;; A tower defense model where stationary towers defend against waves of
;; enemies approaching from all sides. The model demonstrates emergent
;; behavior arising from local agent interactions.

;; ============================================================================
;; BREED DEFINITIONS
;; ============================================================================

breed [ towers tower ]
breed [ enemies enemy ]
breed [ bullets bullet ]

;; ============================================================================
;; AGENT PROPERTIES
;; ============================================================================

towers-own [
  tower-type        ; type of tower (basic, fast, long-range)
  attack-range      ; how far tower can shoot
  fire-rate         ; shots per time period
  damage-per-shot   ; damage dealt per attack
  tower-health      ; health points
  max-health        ; maximum health
  cooldown          ; ticks until can fire again
  kills             ; enemies destroyed by this tower
]

enemies-own [
  enemy-type        ; type of enemy (fast, tough, balanced)
  enemy-health      ; health points
  max-enemy-health  ; maximum health
  enemy-speed       ; movement speed
  enemy-damage      ; damage dealt to towers
  target-tower      ; current target tower
  spawn-side        ; which side enemy spawned from
  attack-cooldown   ; ticks remaining before can attack again
]

bullets-own [
  bullet-damage     ; damage this bullet deals
  bullet-speed      ; movement speed
  target-enemy      ; enemy this bullet is targeting
  lifetime          ; ticks before bullet disappears
]

;; ============================================================================
;; GLOBAL VARIABLES
;; ============================================================================

globals [
  total-enemies-spawned
  total-enemies-destroyed
  total-towers-destroyed
  game-over?
  tick-counter
  
  ;; Stats by type
  fast-enemies-destroyed
  tough-enemies-destroyed
  balanced-enemies-destroyed
  
  ;; Tower type counts
  basic-tower-count
  fast-tower-count
  longrange-tower-count
]

;; ============================================================================
;; SETUP PROCEDURES
;; ============================================================================

to setup
  clear-all
  reset-ticks
  
  ;; Initialize globals
  set total-enemies-spawned 0
  set total-enemies-destroyed 0
  set total-towers-destroyed 0
  set game-over? false
  set tick-counter 0
  set fast-enemies-destroyed 0
  set tough-enemies-destroyed 0
  set balanced-enemies-destroyed 0
  
  ;; Set up environment
  setup-patches
  
  ;; Place towers
  setup-towers
  
  ;; Update displays
  update-monitors
end

to setup-patches
  ;; Create a flat green battlefield background (like inspiration model)
  ask patches [
    set pcolor green + 2
  ]
end

to setup-towers
  ;; Calculate tower type distribution
  let basic-count round (num-towers * basic-tower-percent / 100)
  let fast-count round (num-towers * fast-tower-percent / 100)
  let longrange-count num-towers - basic-count - fast-count
  
  ;; Ensure non-negative counts
  if longrange-count < 0 [ set longrange-count 0 ]
  
  set basic-tower-count basic-count
  set fast-tower-count fast-count
  set longrange-tower-count longrange-count
  
  ;; Place towers in strategic positions
  ;; Use a grid pattern with some randomization
  let tower-positions []
  
  ;; Create a defensive perimeter
  if tower-placement-strategy = "defensive-ring" [
    set tower-positions get-ring-positions num-towers 8
  ]
  
  if tower-placement-strategy = "clustered-center" [
    set tower-positions get-clustered-positions num-towers
  ]
  
  if tower-placement-strategy = "grid" [
    set tower-positions get-grid-positions num-towers
  ]
  
  if tower-placement-strategy = "random" [
    set tower-positions get-random-positions num-towers
  ]
  
  ;; Create towers at positions
  let pos-index 0
  
  ;; Place basic towers
  repeat basic-count [
    if pos-index < length tower-positions [
      let pos item pos-index tower-positions
      create-tower-at (item 0 pos) (item 1 pos) "basic"
      set pos-index pos-index + 1
    ]
  ]
  
  ;; Place fast towers
  repeat fast-count [
    if pos-index < length tower-positions [
      let pos item pos-index tower-positions
      create-tower-at (item 0 pos) (item 1 pos) "fast"
      set pos-index pos-index + 1
    ]
  ]
  
  ;; Place long-range towers
  repeat longrange-count [
    if pos-index < length tower-positions [
      let pos item pos-index tower-positions
      create-tower-at (item 0 pos) (item 1 pos) "longrange"
      set pos-index pos-index + 1
    ]
  ]
end

to create-tower-at [x y type-name]
  create-towers 1 [
    setxy x y
    set tower-type type-name
    set kills 0
    set cooldown 0
    
    ;; Set attributes based on tower type
    ;; Visual styling inspired by reference model
    if tower-type = "basic" [
      set shape "circle"
      set color blue
      set size 2
      set attack-range 8
      set fire-rate 30  ;; cooldown ticks between shots
      set damage-per-shot 15
      set tower-health 100
      set max-health 100
    ]
    
    if tower-type = "fast" [
      set shape "square"
      set color yellow
      set size 2
      set attack-range 6
      set fire-rate 15   ;; shoots faster
      set damage-per-shot 8
      set tower-health 80
      set max-health 80
    ]
    
    if tower-type = "longrange" [
      set shape "house"
      set color red
      set size 2
      set attack-range 12
      set fire-rate 50  ;; shoots slower
      set damage-per-shot 35
      set tower-health 120
      set max-health 120
    ]
  ]
end

;; ============================================================================
;; TOWER PLACEMENT STRATEGIES
;; ============================================================================

to-report get-ring-positions [n radius]
  let positions []
  let angle-step 360 / n
  repeat n [
    let angle length positions * angle-step
    let x radius * cos angle
    let y radius * sin angle
    ;; Ensure within world bounds
    if abs x < max-pxcor - 1 and abs y < max-pycor - 1 [
      set positions lput (list x y) positions
    ]
  ]
  report positions
end

to-report get-clustered-positions [n]
  let positions []
  repeat n [
    let x random-float 10 - 5
    let y random-float 10 - 5
    set positions lput (list x y) positions
  ]
  report positions
end

to-report get-grid-positions [n]
  let positions []
  let grid-size ceiling sqrt n
  ;; Calculate spacing to ensure positions fit within world bounds
  ;; Use 80% of available space to keep away from edges
  let available-width (max-pxcor - 2) * 1.6
  let available-height (max-pycor - 2) * 1.6
  let spacing-x available-width / (grid-size + 1)
  let spacing-y available-height / (grid-size + 1)
  
  let num-placed 0
  let row 0
  let max-iterations n * 10  ;; Safety limit to prevent infinite loops
  let iterations 0
  
  while [num-placed < n and iterations < max-iterations] [
    let col 0
    while [col < grid-size and num-placed < n] [
      ;; Calculate position centered around origin
      let x (col - (grid-size - 1) / 2) * spacing-x
      let y (row - (grid-size - 1) / 2) * spacing-y
      
      ;; Ensure within bounds
      if abs x < max-pxcor - 2 and abs y < max-pycor - 2 [
        set positions lput (list x y) positions
        set num-placed num-placed + 1
      ]
      set col col + 1
      set iterations iterations + 1
    ]
    set row row + 1
    
    ;; If we've filled the grid but still need more positions, expand
    if row >= grid-size and num-placed < n [
      set row 0
      set grid-size grid-size + 1
      ;; Recalculate spacing with new grid size
      set spacing-x available-width / (grid-size + 1)
      set spacing-y available-height / (grid-size + 1)
    ]
  ]
  
  ;; If we still don't have enough positions, fill with random valid positions
  while [num-placed < n] [
    let x random-float (max-pxcor * 1.6) - max-pxcor * 0.8
    let y random-float (max-pycor * 1.6) - max-pycor * 0.8
    if abs x < max-pxcor - 2 and abs y < max-pycor - 2 [
      set positions lput (list x y) positions
      set num-placed num-placed + 1
    ]
  ]
  
  report positions
end

to-report get-random-positions [n]
  let positions []
  repeat n [
    let x random-float (max-pxcor * 1.6) - max-pxcor * 0.8
    let y random-float (max-pycor * 1.6) - max-pycor * 0.8
    ;; Keep away from edges
    if abs x < max-pxcor - 2 and abs y < max-pycor - 2 [
      set positions lput (list x y) positions
    ]
  ]
  report positions
end

;; ============================================================================
;; MAIN LOOP
;; ============================================================================

to go
  if game-over? [ stop ]
  
  ;; Reset patches to base color
  ask patches [ set pcolor green + 2 ]
  
  ;; Spawn enemies
  spawn-enemies
  
  ;; Update agents
  ask enemies [ enemy-behavior ]
  ask towers [ tower-behavior ]
  ask bullets [ bullet-behavior ]
  
  ;; Check game over conditions
  check-game-over
  
  ;; Update displays
  update-monitors
  
  tick
  set tick-counter ticks
end

;; ============================================================================
;; ENEMY SPAWNING
;; ============================================================================

to spawn-enemies
  ;; Check if we've reached the maximum enemy spawn limit
  if max-enemies-spawn > 0 and total-enemies-spawned >= max-enemies-spawn [
    ;; Stop spawning once limit reached
    stop
  ]
  
  ;; Spawn enemies based on spawn rate (percentage chance per tick)
  ;; Spawn multiple enemies if spawn rate is high
  let spawn-chance enemy-spawn-rate
  
  ;; Spawn 1-3 enemies depending on spawn rate
  if random 100 < spawn-chance [
    spawn-enemy
  ]
  
  ;; Additional spawns for higher spawn rates
  if spawn-chance > 25 and random 100 < (spawn-chance - 25) [
    spawn-enemy
  ]
  
  if spawn-chance > 35 and random 100 < (spawn-chance - 35) [
    spawn-enemy
  ]
end

to spawn-enemy
  ;; Check if we've reached the maximum enemy spawn limit
  if max-enemies-spawn > 0 and total-enemies-spawned >= max-enemies-spawn [
    ;; Don't spawn if limit reached
    stop
  ]
  
  ;; Choose random side to spawn from
  let side one-of ["top" "bottom" "left" "right"]
  let spawn-x 0
  let spawn-y 0
  
  ;; Set spawn position based on side
  if side = "top" [
    set spawn-x random-xcor
    set spawn-y max-pycor - 1
  ]
  if side = "bottom" [
    set spawn-x random-xcor
    set spawn-y min-pycor + 1
  ]
  if side = "left" [
    set spawn-x min-pxcor + 1
    set spawn-y random-ycor
  ]
  if side = "right" [
    set spawn-x max-pxcor - 1
    set spawn-y random-ycor
  ]
  
  ;; Determine enemy type based on distribution
  let rand random 100
  let type-name ""
  
  if rand < fast-enemy-percent [
    set type-name "fast"
  ]
  if rand >= fast-enemy-percent and rand < (fast-enemy-percent + tough-enemy-percent) [
    set type-name "tough"
  ]
  if type-name = "" [
    set type-name "balanced"
  ]
  
  ;; Create enemy
  create-enemies 1 [
    setxy spawn-x spawn-y
    set enemy-type type-name
    set spawn-side side
    set target-tower nobody
    
    ;; Set attributes based on enemy type
    ;; Using "person" shape for zombie-like appearance (inspired by reference model)
    if enemy-type = "fast" [
      set shape "person"
      set color red
      set size 1.5
      set enemy-speed 0.3  ;; Reduced from 1.5
      set enemy-health 30 * enemy-health-multiplier
      set max-enemy-health enemy-health
      set enemy-damage 5
      set attack-cooldown 0
    ]
    
    if enemy-type = "tough" [
      set shape "person"
      set color orange
      set size 1.8
      set enemy-speed 0.15  ;; Reduced from 0.5
      set enemy-health 120 * enemy-health-multiplier  ;; Increased from 100
      set max-enemy-health enemy-health
      set enemy-damage 15
      set attack-cooldown 0
    ]
    
    if enemy-type = "balanced" [
      set shape "person"
      set color yellow
      set size 1.5
      set enemy-speed 0.2  ;; Reduced from 1.0
      set enemy-health 60 * enemy-health-multiplier  ;; Increased from 50
      set max-enemy-health enemy-health
      set enemy-damage 10
      set attack-cooldown 0
    ]
  ]
  
  set total-enemies-spawned total-enemies-spawned + 1
end

;; ============================================================================
;; ENEMY BEHAVIOR
;; ============================================================================

to enemy-behavior
  ;; Update attack cooldown
  if attack-cooldown > 0 [
    set attack-cooldown attack-cooldown - 1
  ]
  
  ;; Find nearest tower
  if any? towers [
    set target-tower min-one-of towers [distance myself]
    
    if target-tower != nobody [
      ;; Move toward target
      face target-tower
      forward enemy-speed
      
      ;; Check if close enough to attack
      if distance target-tower < 2 and attack-cooldown = 0 [
        attack-tower
        set attack-cooldown 30  ;; Wait 30 ticks before next attack
      ]
    ]
  ]
  
  ;; Update health display (visual feedback)
  update-enemy-color
end

to attack-tower
  ;; Deal damage to tower
  if target-tower != nobody and member? target-tower towers [
    ask target-tower [
      set tower-health tower-health - [enemy-damage] of myself
      
      ;; Check if tower is destroyed
      if tower-health <= 0 [
        set total-towers-destroyed total-towers-destroyed + 1
        die
      ]
    ]
  ]
end

to update-enemy-color
  ;; Update color based on health and danger status (inspired by reference model)
  if max-enemy-health > 0 [
    let health-percent enemy-health / max-enemy-health
    
    ;; Check if in danger (within tower range)
    let in-danger? any? towers with [distance myself <= attack-range]
    
    ;; Scale color by health
    if enemy-type = "fast" [
      ifelse in-danger? [
        set color scale-color red health-percent 0 1.2  ;; Brighter when in danger
      ] [
        set color scale-color red health-percent 0 1.5  ;; Darker when safe
      ]
    ]
    if enemy-type = "tough" [
      ifelse in-danger? [
        set color scale-color orange health-percent 0 1.2
      ] [
        set color scale-color orange health-percent 0 1.5
      ]
    ]
    if enemy-type = "balanced" [
      ifelse in-danger? [
        set color scale-color yellow health-percent 0 1.2
      ] [
        set color scale-color yellow health-percent 0 1.5
      ]
    ]
  ]
end

;; ============================================================================
;; TOWER BEHAVIOR
;; ============================================================================

to tower-behavior
  ;; Update cooldown
  if cooldown > 0 [
    set cooldown cooldown - 1
  ]
  
  ;; Check if under attack
  let under-attack? any? enemies in-radius 2
  
  ;; Look for enemies in range
  let targets enemies in-radius attack-range
  
  if any? targets and cooldown = 0 [
    ;; Select target (nearest enemy)
    let target min-one-of targets [distance myself]
    
    if target != nobody [
      ;; Fire projectile
      fire-at target
      set cooldown fire-rate
    ]
  ]
  
  ;; Update tower visual appearance
  update-tower-appearance under-attack?
end

to fire-at [target-enemy-agent]
  ;; Create bullet/projectile (visual style from reference model)
  hatch-bullets 1 [
    set bullet-damage [damage-per-shot] of myself
    set bullet-speed 0.5  ;; Reduced from 1.5 for better visibility
    set target-enemy target-enemy-agent
    set lifetime 100  ;; Increased from 50 to allow longer travel time
    set shape "circle"
    set size 0.5
    
    ;; Color projectile based on tower type (like reference model)
    let source-type [tower-type] of myself
    if source-type = "basic" [ set color cyan ]
    if source-type = "fast" [ set color yellow ]
    if source-type = "longrange" [ set color orange ]
    
    ;; Face target
    if target-enemy != nobody [
      face target-enemy
    ]
  ]
end

to update-tower-appearance [is-under-attack]
  ;; Update color based on health (inspired by reference model)
  if max-health > 0 [
    let health-percent tower-health / max-health
    
    ;; Darken color as health decreases
    if tower-type = "basic" [
      set color scale-color blue health-percent 0 1
    ]
    if tower-type = "fast" [
      set color scale-color yellow health-percent 0 1
    ]
    if tower-type = "longrange" [
      set color scale-color red health-percent 0 1
    ]
  ]
  
  ;; Pulse when under attack (visual feedback from reference model)
  ifelse is-under-attack [
    set size 2.5
  ] [
    set size 2
  ]
  
  ;; Show tower range if enabled (like reference model)
  if show-tower-range? [
    ask patches in-radius attack-range [
      if pcolor = green + 2 [
        set pcolor green + 1
      ]
    ]
  ]
end

;; ============================================================================
;; BULLET BEHAVIOR
;; ============================================================================

to bullet-behavior
  ;; Update lifetime
  set lifetime lifetime - 1
  
  if lifetime <= 0 [
    die
  ]
  
  ;; Check if target still exists and is valid
  if target-enemy != nobody [
    if not member? target-enemy enemies [
      set target-enemy nobody
    ]
  ]
  
  ;; Move toward target or straight ahead
  if target-enemy != nobody [
    face target-enemy
  ]
  
  ;; Move forward
  forward bullet-speed
  
  ;; Check if out of bounds
  if abs xcor > max-pxcor or abs ycor > max-pycor [
    die
    stop
  ]
  
  ;; Check for collision with enemies
  let hit-enemies enemies-here
  if any? hit-enemies [
    let target-hit one-of hit-enemies
    ask target-hit [
      set enemy-health enemy-health - [bullet-damage] of myself
      
      ;; Check if enemy is destroyed
      if enemy-health <= 0 [
        ;; Record kill
        set total-enemies-destroyed total-enemies-destroyed + 1
        
        ;; Track by type
        if enemy-type = "fast" [
          set fast-enemies-destroyed fast-enemies-destroyed + 1
        ]
        if enemy-type = "tough" [
          set tough-enemies-destroyed tough-enemies-destroyed + 1
        ]
        if enemy-type = "balanced" [
          set balanced-enemies-destroyed balanced-enemies-destroyed + 1
        ]
        
        die
      ]
    ]
    die  ;; bullet disappears on hit
  ]
end

;; ============================================================================
;; GAME STATE
;; ============================================================================

to check-game-over
  ;; Game over if all towers destroyed
  if not any? towers [
    set game-over? true
    user-message (word "DEFEAT! All towers destroyed.\n"
                       "Survived: " ticks " ticks\n"
                       "Enemies destroyed: " total-enemies-destroyed "\n"
                       "Enemies spawned: " total-enemies-spawned)
    stop
  ]
  
  ;; Victory: max enemies spawned and all enemies destroyed
  if max-enemies-spawn > 0 and total-enemies-spawned >= max-enemies-spawn and not any? enemies [
    set game-over? true
    user-message (word "VICTORY! All enemies defeated!\n"
                       "Ticks: " ticks "\n"
                       "Enemies destroyed: " total-enemies-destroyed "\n"
                       "Towers remaining: " count towers "\n"
                       "Towers destroyed: " total-towers-destroyed)
    stop
  ]
  
  ;; Timeout: stop after maximum ticks
  if ticks >= max-simulation-ticks [
    set game-over? true
    ;; Always show final status when time runs out
    ifelse max-enemies-spawn > 0 and total-enemies-spawned >= max-enemies-spawn and not any? enemies [
      ;; Victory achieved
      user-message (word "VICTORY! All enemies defeated!\n"
                         "Ticks: " ticks "\n"
                         "Enemies destroyed: " total-enemies-destroyed "\n"
                         "Towers remaining: " count towers "\n"
                         "Towers destroyed: " total-towers-destroyed)
    ] [
      ;; Time ran out - show status
      user-message (word "TIME'S UP!\n"
                         "Ticks: " ticks "\n"
                         "Enemies destroyed: " total-enemies-destroyed " / " total-enemies-spawned "\n"
                         "Enemies remaining: " count enemies "\n"
                         "Towers remaining: " count towers)
    ]
    stop
  ]
end

to update-monitors
  ;; Monitors are updated automatically by NetLogo
  ;; This procedure can be used for additional updates if needed
end

;; ============================================================================
;; ANALYSIS HELPERS
;; ============================================================================

to-report towers-alive
  report count towers
end

to-report enemies-alive
  report count enemies
end

to-report average-tower-health
  ifelse any? towers [
    report mean [tower-health] of towers
  ] [
    report 0
  ]
end

to-report kill-rate
  ifelse total-enemies-spawned > 0 [
    report (total-enemies-destroyed / total-enemies-spawned) * 100
  ] [
    report 0
  ]
end

to-report enemies-remaining
  ;; Report how many enemies are left to spawn (0 if unlimited mode)
  ifelse max-enemies-spawn > 0 [
    let remaining (max-enemies-spawn - total-enemies-spawned)
    report ifelse-value (remaining > 0) [remaining] [0]
  ] [
    report 0  ;; Unlimited mode
  ]
end]]></code>
  <widgets>
    <view x="210" wrappingAllowedX="false" y="20" frameRate="30.0" minPycor="-14" height="430" showTickCounter="true" patchSize="15.0" fontSize="10" wrappingAllowedY="false" width="761" tickCounterLabel="ticks" maxPycor="13" updateMode="1" maxPxcor="24" minPxcor="-25"></view>
    <note x="20" y="5" backgroundDark="0" fontSize="12" width="150" markdown="false" height="18" textColorDark="-1" textColorLight="-16777216" backgroundLight="0">Controls</note>
    <button x="15" y="28" height="40" disableUntilTicks="false" forever="false" kind="Observer" width="73" display="Setup">setup</button>
    <button x="95" y="28" height="40" disableUntilTicks="true" forever="true" kind="Observer" width="73" display="Go">go</button>
    <note x="20" y="73" backgroundDark="0" fontSize="11" width="150" markdown="false" height="18" textColorDark="-1" textColorLight="-16777216" backgroundLight="0">Tower Settings</note>
    <slider x="15" step="1" y="96" max="20" width="172" display="num-towers" height="50" min="3" direction="Horizontal" default="15.0" variable="num-towers"></slider>
    <slider x="15" step="5" y="153" max="100" width="172" display="basic-tower-percent" height="50" min="0" direction="Horizontal" default="30.0" variable="basic-tower-percent" units="%"></slider>
    <slider x="15" step="5" y="210" max="100" width="172" display="fast-tower-percent" height="50" min="0" direction="Horizontal" default="20.0" variable="fast-tower-percent" units="%"></slider>
    <chooser x="15" y="267" height="60" variable="tower-placement-strategy" current="2" width="172" display="tower-placement-strategy">
      <choice type="string" value="defensive-ring"></choice>
      <choice type="string" value="clustered-center"></choice>
      <choice type="string" value="grid"></choice>
      <choice type="string" value="random"></choice>
    </chooser>
    <note x="20" y="337" backgroundDark="0" fontSize="11" width="150" markdown="false" height="18" textColorDark="-1" textColorLight="-16777216" backgroundLight="0">Enemy Settings</note>
    <slider x="15" step="1" y="357" max="50" width="172" display="enemy-spawn-rate" height="50" min="5" direction="Horizontal" default="5.0" variable="enemy-spawn-rate" units="%"></slider>
    <slider x="15" step="0.1" y="414" max="3.0" width="172" display="enemy-health-multiplier" height="50" min="0.5" direction="Horizontal" default="0.8" variable="enemy-health-multiplier"></slider>
    <slider x="15" step="5" y="471" max="100" width="172" display="fast-enemy-percent" height="50" min="0" direction="Horizontal" default="40.0" variable="fast-enemy-percent" units="%"></slider>
    <slider x="15" step="5" y="528" max="100" width="172" display="tough-enemy-percent" height="50" min="0" direction="Horizontal" default="20.0" variable="tough-enemy-percent" units="%"></slider>
    <slider x="15" step="10" y="585" max="500" width="172" display="max-enemies-spawn" height="50" min="0" direction="Horizontal" default="120.0" variable="max-enemies-spawn"></slider>
    <note x="20" y="645" backgroundDark="0" fontSize="11" width="150" markdown="false" height="18" textColorDark="-1" textColorLight="-16777216" backgroundLight="0">Other Settings</note>
    <slider x="15" step="100" y="665" max="5000" width="172" display="max-simulation-ticks" height="50" min="500" direction="Horizontal" default="2000.0" variable="max-simulation-ticks"></slider>
    <switch x="15" y="722" height="40" on="false" variable="show-tower-range?" width="172" display="show-tower-range?"></switch>
