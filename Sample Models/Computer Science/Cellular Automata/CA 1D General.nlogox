    <view x="215" wrappingAllowedX="true" y="10" frameRate="30.0" minPycor="-64" height="567" showTickCounter="true" patchSize="4.5" fontSize="10" wrappingAllowedY="false" width="567" tickCounterLabel="ticks" maxPycor="64" updateMode="1" maxPxcor="64" minPxcor="-64"></view>
    <note x="10" y="10" backgroundDark="0" fontSize="12" width="195" markdown="false" height="26" textColorDark="-1" textColorLight="-16777216" backgroundLight="0">1. WORLD AND STATES </note>
    <note x="10" y="200" backgroundDark="0" fontSize="12" width="195" markdown="false" height="20" textColorDark="-1" textColorLight="-16777216" backgroundLight="0">2. RULE  </note>
