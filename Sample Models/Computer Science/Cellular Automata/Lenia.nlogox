<?xml version="1.0" encoding="utf-8"?>
<model version="NetLogo 7.1.0-alpha1" title="Lenia" snapToGrid="true">
  <code><![CDATA[
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Lenia - Continuous Cellular Automata Artifical Life Model
;; A continuous generalization of Conway's Game of Life
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

extensions [palette]

patches-own [
  state         ;; continuous value from 0 to 1
  new-state     ;; buffer for the potential field U produced by convolution
  my-neighbors  ;; precomputed list of [neighbor-patch weight] pairs
]

globals [
  kernel     ;; list of [kx ky weight] triples describing the convolution kernel
]

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Setup Procedures
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

to setup
  clear-all
  configure-organism               ;; named creatures set their own parameters
  setup-kernel
  ask patches [
    precompute-neighbors           ;; cache kernel neighbors for fast convolution
    set state 0
  ]
  ifelse initial-config = "Random" [
    ask patches [ set state random-float 1.0 ]
  ] [
    seed-organism initial-config   ;; initialize the chosen creature at the center
  ]
  ask patches [ update-color ]
  reset-ticks
end

to setup-kernel
  ;; Build a bell-shaped ring kernel:
  ;;   K(d) = bell(d, kernel-center, kernel-width) for normalized distance d < 1
  ;; kernel-center is where the ring peaks (as a fraction of the radius) and
  ;; kernel-width is how thick/fuzzy the ring is. The kernel is zero outside the
  ;; unit circle and is normalized so all weights sum to 1.
  let r kernel-radius
  set kernel []
  let total-weight 0

  ;; Scan the (2r+1) x (2r+1) box centered on the origin. Centering the loop
  ;; here (rather than offsetting the distance) keeps the kernel symmetric.
  let kx (- r)
  while [kx <= r] [
    let ky (- r)
    while [ky <= r] [
      ;; Normalized distance from center: 0 at the center, 1 at radius r.
      let dist (sqrt ((kx ^ 2) + (ky ^ 2))) / r
      if dist < 1 [                                  ;; keep cells inside the unit circle
        let weight bell dist kernel-center kernel-width
        set kernel lput (list kx ky weight) kernel
        set total-weight total-weight + weight
      ]
      set ky ky + 1
    ]
    set kx kx + 1
  ]

  ;; Normalize so the kernel weights sum to 1.
  set kernel map [ k -> (list (item 0 k) (item 1 k) ((item 2 k) / total-weight)) ] kernel
end

to precompute-neighbors ;patch procedure
  ;; Cache each in-kernel neighbor together with its weight so the update loop
  ;; never recomputes offsets. patch-at resolves the toroidal wraparound.
  set my-neighbors []
  foreach kernel [ k ->
    let kx item 0 k
    let ky item 1 k
    let weight item 2 k
    let neighbor patch-at kx ky
    if neighbor != nobody [
      set my-neighbors lput (list neighbor weight) my-neighbors
    ]
  ]
end

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Organisms
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

to configure-organism
  ;; Named creatures only survive with their associated parameters, so loading one
  ;; sets the sliders to match (all use radius 13, T = 10, the standard single
  ;; ring, and differ only in the growth window). "Random" leaves sliders as-is.
  if initial-config != "Random" [
    set kernel-radius 13
    set time-scale 10
    set kernel-center 0.5
    set kernel-width 0.15
  ]

  ;;; {{{ umit: the following lines break <one command per line> rule of the style guide }}}

  (ifelse initial-config = "Orbium" [
    set growth-center 0.15
    set growth-width 0.015
  ]
  initial-config = "Gyrorbium" [
    set growth-center 0.156
    set growth-width 0.0224 ]

  initial-config = "Scutium" [
    set growth-center 0.29
    set growth-width 0.045
  ]
  initial-config = "Discutium" [
    set growth-center 0.356
    set growth-width 0.063
  ])
end

to seed-organism [creature]
  ;; Initialize a creature's pattern onto the patches, centered on the origin.
  let cells creature-seed creature
  let n-rows length cells
  let n-cols length item 0 cells
  let x-off floor (n-cols / 2)
  let y-off floor (n-rows / 2)
  foreach range n-rows [ row ->
    foreach range n-cols [ col ->
      ask patch (col - x-off) (row - y-off) [
        set state item col (item row cells)
      ]
    ]
  ]
end

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Go Procedures
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

to go
  ;; Step 1: compute the potential field U at every patch (the convolution).
  ask patches [
    set new-state compute-convolution
  ]
  ;; Step 2: apply the growth function and integrate with time step 1 / T,
  ;; clipping the result back into [0, 1].
  ask patches [
    set state clip (state + (1 / time-scale) * (growth-function new-state))
    update-color
  ]
  tick
end

to-report compute-convolution ; patch procedure
  ;; Convolve the kernel with the local neighborhood using the precomputed
  ;; [neighbor weight] pairs.
  let total 0
  foreach my-neighbors [ pair ->
    set total total + (([state] of item 0 pair) * (item 1 pair))
  ]
  report total
end

to-report growth-function [u]
  ;; Growth mapped to [-1, 1]: g(u) = 2 * bell(u, m, s) - 1
  report ((bell u growth-center growth-width) * 2) - 1
end

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Drawing
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

to draw
  ;; Paint your own configuration: hold this button down and drag the mouse
  ;; inside the world to brush in live cells. brush-size sets the radius.
  if mouse-inside? and mouse-down? [
    ask patch mouse-xcor mouse-ycor [
      ask patches in-radius brush-size [
        set state 1
        update-color
      ]
    ]
    display              ;; force a refresh so strokes show between ticks
  ]
end

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Helper Reporters
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

to-report bell [x mu sigma]
  ;; Gaussian-like bell curve: exp(-((x - mu) / sigma)^2 / 2)
  report exp (-1 * (((x - mu) / sigma) ^ 2) / 2)
end

to-report clip [x]
  ;; Constrain a value to [0, 1].
  report (ifelse-value x <= 0 [0] x >= 1 [1] [x])
end

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Display Procedures
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

to update-color ;; patch procedure
  ;; Color each patch by its state; the color-scheme chooser picks the palette.
  (ifelse
  color-scheme = "Viridis" [
    set pcolor palette:scale-gradient [[68 1 84] [59 82 139] [33 145 140] [94 201 98] [253 231 37]] state 0 1
  ]
  color-scheme = "Magma" [
    set pcolor palette:scale-gradient [[13 8 135] [126 3 168] [204 71 120] [248 149 64] [240 249 33]] state 0 1
  ]
  [ ;; Monochrome: black (0) to white (1)
    set pcolor scale-color white state 0 1
  ])
end

to reset-states
  ask patches [
    set state 0
    update-color
  ]
end

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Creature Library
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

to-report creature-seed [creature]
  report (ifelse-value
  creature = "Orbium"    [ orbium-seed ]
  creature = "Gyrorbium" [ gyrorbium-seed ]
  creature = "Scutium"   [ scutium-seed ]
  creature = "Discutium" [ discutium-seed ]
  [ [[0]] ])
end

